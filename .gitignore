# ── Protecoes do Auroq OS (adicionadas automaticamente) ──
# Segredos — NUNCA sobem pro GitHub
.env
.env.local
.env.*.local
.npmrc
business/vault/
*.key
*.pem

# Dados pessoais do Jorge Helder (CPF, CNPJ, endereco fiscal) — so local, repo pode ser publico
OLÁ DADOS CADASTRAIS/

# Runtime — se recria sozinho em cada maquina
node_modules/
.auroq/
.synapse/sessions/
.tmp/
*.tmp
*.log

# Skills do Codex — geradas por maquina
.agents/skills/

# Sistema operacional
.DS_Store
Thumbs.db

# Midia pesada — fica no Drive, nao no repo
*.png
*.jpeg
*.jpg
*.mp4
*.mov
*.mp3
*.wav
*.m4a

# Excecao: assets do site publico (docs/), precisam estar no repo pro GitHub Pages servir
!docs/assets/*.png
!docs/assets/*.jpg
!docs/mapa-do-hoje/img/*.png
!docs/mapa-do-hoje/img/*.jpg
!docs/mapa-do-hoje/qr/*.png

# Excecao: produtos ativos na esteira de negocios (business/produtos/), material permanente
!business/produtos/**/*.png
!business/produtos/**/*.jpg
